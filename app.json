{
  "expo": {
    "name": "Nanny App",
    "slug": "nanny-app",
    "version": "1.0.0",
    "scheme": "nannyapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF6E6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prakhar9129.heyshishu-nannyapp",
      "buildNumber": "2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nanny App needs your location to show your live position to parents.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Nanny App needs location to track your route.",
        "NSMicrophoneUsageDescription": "Nanny App needs microphone to record session audio for safety."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF6E6"
      },
      "package": "com.heyshishu.nannyapp",
      "edgeToEdgeEnabled": true,
      "navigationBarColor": "#FFF6E6",
      "navigationBarTranslucent": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCyNAW5GlsMpBGylWnbhzzCl9AjPt490Oo"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-audio",
      "expo-video",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app needs location access to track your journey."
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HeyShishu Nanny to access your camera."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HeyShishu Nanny to access your photos."
        }
      ]
    ]
  }
}
